# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=3000

# SQLite database file (created automatically the first time the app runs).
DB_FILE=./data/gmedic.sqlite

# Long random string used to sign session cookies (required in production).
SESSION_SECRET=replace-with-a-long-random-string

# Session idle timeout without "Remember me" (minutes) and absolute maximum (hours).
SESSION_IDLE_MINUTES=720
SESSION_MAX_HOURS=72

# Extra origins allowed to call the API with credentials (comma separated).
# Leave empty: the portal itself is same-origin and needs no CORS.
CORS_ORIGINS=

# Link encoded in QR codes: <QR_BASE_URL>/<hospitalId>?k=<qr key>.
QR_BASE_URL=https://gmedic.app/h

# Where uploaded KYC documents are stored (outside /public; served only to admins).
UPLOAD_DIR=storage/uploads

# Set to true when running behind HTTPS (e.g. a reverse proxy).
SECURE_COOKIES=false
TRUST_PROXY=false
