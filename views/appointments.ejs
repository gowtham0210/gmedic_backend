<%- include('partials/app-start') %>

<div class="page-head">
  <div>
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dashboard">Dashboard</a><%- icon('chevron-right') %><span>Appointments</span></nav>
    <h1>Appointments</h1>
    <p>Appointments booked by patients through the Gmedic app.</p>
  </div>
  <div class="chips" role="group" aria-label="Quick date range" data-date-chips>
    <button type="button" class="chip" data-range="today">Today</button>
    <button type="button" class="chip" data-range="tomorrow">Tomorrow</button>
    <button type="button" class="chip" data-range="week">Next 7 days</button>
    <button type="button" class="chip" data-range="all">All dates</button>
  </div>
</div>

<article class="card card--flush">
  <form class="toolbar" data-filters role="search">
    <div class="field toolbar__search">
      <label for="f-q">Search</label>
      <div class="input-wrap"><%- icon('search') %><input class="input" id="f-q" name="q" type="search" placeholder="Patient, doctor or appointment ID"></div>
    </div>
    <div class="field toolbar__item">
      <label for="f-date">Date</label>
      <input class="input" id="f-date" name="date" type="date">
    </div>
    <div class="field toolbar__item">
      <label for="f-doctor">Doctor</label>
      <select class="select" id="f-doctor" name="doctorId"><option value="">All doctors</option></select>
    </div>
    <div class="field toolbar__item">
      <label for="f-pay">Payment status</label>
      <select class="select" id="f-pay" name="paymentStatus">
        <option value="">All</option>
        <option value="paid">Paid</option>
        <option value="pending">Pending</option>
      </select>
    </div>
    <button type="reset" class="btn btn--ghost" data-reset><%- icon('refresh') %>Reset</button>
  </form>

  <div class="tabs" role="tablist" aria-label="Appointment status" data-status-tabs>
    <button type="button" role="tab" class="tab is-active" data-status="">All <span class="tab__count" data-count="all">–</span></button>
    <button type="button" role="tab" class="tab" data-status="confirmed">Confirmed <span class="tab__count" data-count="confirmed">–</span></button>
    <button type="button" role="tab" class="tab" data-status="pending">Pending <span class="tab__count" data-count="pending">–</span></button>
    <button type="button" role="tab" class="tab" data-status="completed">Completed <span class="tab__count" data-count="completed">–</span></button>
    <button type="button" role="tab" class="tab" data-status="cancelled">Cancelled <span class="tab__count" data-count="cancelled">–</span></button>
  </div>

  <div class="table-wrap" style="padding:14px 8px 0">
    <table class="table table--stack">
      <thead>
        <tr>
          <th>Patient Name</th><th>Doctor</th><th>Specialist</th>
          <th><button type="button" class="auth__link" style="color:inherit;font-weight:600" data-sort aria-label="Sort by date">Date <span data-sort-arrow>↓</span></button></th>
          <th>Time</th><th class="num">Fee</th><th>Payment Status</th><th>Appointment Status</th><th class="col-actions"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody data-appt-rows>
        <tr><td colspan="9"><div class="skeleton skeleton--row"></div><div class="skeleton skeleton--row"></div><div class="skeleton skeleton--row"></div><div class="skeleton skeleton--row"></div></td></tr>
      </tbody>
    </table>
  </div>
  <div class="pager" data-pager></div>
</article>

<%- include('partials/modals/appointment') %>
<%- include('partials/app-end') %>
