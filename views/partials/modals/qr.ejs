<div class="modal" id="qr-modal" role="dialog" aria-modal="true" aria-labelledby="qr-title" hidden>
  <div class="modal__backdrop" data-modal-close></div>
  <div class="modal__panel modal__panel--poster">
    <div class="modal__head">
      <div class="modal__icon tone-teal"><%- icon('qr-code') %></div>
      <div>
        <h2 id="qr-title">Hospital QR Code</h2>
        <p>Display this at reception. Patients scan it in the Gmedic app to add <%= hospital.name %>.</p>
      </div>
      <button type="button" class="icon-btn" data-modal-close aria-label="Close"><%- icon('x') %></button>
    </div>
    <div class="modal__body qr-modal">
      <img class="qr-poster" alt="Gmedic QR poster for <%= hospital.name %>" width="1060" height="1500" data-qr-poster>
    </div>
    <div class="modal__foot modal__foot--split">
      <a class="btn btn--ghost btn--sm" href="/api/hospital/qr.png?download=1" download><%- icon('qr-code') %>QR code only</a>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <button type="button" class="btn btn--ghost" data-qr-print><%- icon('printer') %>Print</button>
        <button type="button" class="btn btn--primary" data-download-poster><%- icon('download') %><span>Download QR</span></button>
      </div>
    </div>
  </div>
</div>
