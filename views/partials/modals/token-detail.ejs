<div class="modal" id="token-detail-modal" role="dialog" aria-modal="true" aria-labelledby="td-title" hidden>
  <div class="modal__backdrop" data-modal-close></div>
  <div class="modal__panel">
    <div class="modal__head">
      <div class="modal__icon tone-teal"><%- icon('ticket') %></div>
      <div>
        <h2 id="td-title">Token details</h2>
        <p data-token-sub>Queue token for a patient visit</p>
      </div>
      <button type="button" class="icon-btn" data-modal-close aria-label="Close"><%- icon('x') %></button>
    </div>
    <div class="modal__body" data-token-body>
      <div class="skeleton skeleton--row"></div><div class="skeleton skeleton--row"></div>
    </div>
    <div class="modal__foot modal__foot--split">
      <button type="button" class="btn btn--ghost" style="color:var(--red-600)" data-token-cancel><%- icon('x') %><span>Cancel token</span></button>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <label for="td-status" class="field__label nowrap">Status</label>
        <select class="select" id="td-status" style="height:40px;min-width:150px" data-token-status>
          <option value="waiting">Waiting</option>
          <option value="called">Called</option>
          <option value="completed">Completed</option>
        </select>
        <button type="button" class="btn btn--primary" data-token-save disabled><%- icon('check') %><span>Update</span></button>
      </div>
    </div>
  </div>
</div>
