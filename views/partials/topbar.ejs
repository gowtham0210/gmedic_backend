<header class="topbar">
  <button type="button" class="icon-btn topbar__menu" data-sidebar-toggle aria-label="Toggle sidebar" aria-controls="sidebar"><%- icon('menu') %></button>

  <a href="/hospital" class="hospital-chip" title="Your hospital">
    <%- icon('hospital') %>
    <span class="hospital-chip__name"><%= hospital.name %></span>
    <span class="hospital-chip__id"><%= hospital.id %></span>
  </a>

  <div class="global-search" data-global-search>
    <button type="button" class="icon-btn icon-btn--bordered global-search__toggle" aria-label="Search" data-search-toggle><%- icon('search') %></button>
    <div class="global-search__field">
      <%- icon('search', 'icon--sm') %>
      <input type="search" placeholder="Search doctors or patients…" aria-label="Search doctors or patients" autocomplete="off" spellcheck="false" data-search-input>
      <kbd aria-hidden="true">/</kbd>
    </div>
    <div class="search-results" role="listbox" hidden data-search-results></div>
  </div>

  <div class="topbar__actions">
    <div class="dropdown" data-dropdown>
      <button type="button" class="icon-btn icon-btn--bordered" aria-label="Notifications" aria-haspopup="true" aria-expanded="false" data-dropdown-toggle data-notif-toggle>
        <%- icon('bell') %><span class="dot-badge" hidden data-notif-count></span>
      </button>
      <div class="dropdown__menu dropdown__menu--wide" role="menu">
        <div class="notif__head">
          <h3>Notifications</h3>
          <button type="button" class="auth__link" data-notif-read>Mark all as read</button>
        </div>
        <div class="notif__list" data-notif-list>
          <div class="skeleton skeleton--row"></div><div class="skeleton skeleton--row"></div>
        </div>
        <a class="notif__foot" href="/appointments">View all appointments</a>
      </div>
    </div>

    <span class="topbar__divider" aria-hidden="true"></span>

    <div class="dropdown" data-dropdown>
      <button type="button" class="profile-btn" aria-haspopup="true" aria-expanded="false" data-dropdown-toggle aria-label="Account menu">
        <span class="avatar avatar--teal" data-user-initials><%= user.initials %></span>
        <span class="profile-btn__text"><strong data-user-name><%= user.name %></strong><small>Receptionist</small></span>
        <%- icon('chevron-down') %>
      </button>
      <div class="dropdown__menu" role="menu">
        <div class="dropdown__header">
          <span class="avatar avatar--teal" data-user-initials><%= user.initials %></span>
          <div><strong data-user-name><%= user.name %></strong><small><%= user.email %></small></div>
        </div>
        <a class="dropdown__item" role="menuitem" href="/settings"><%- icon('user') %>My profile</a>
        <a class="dropdown__item" role="menuitem" href="/settings#password"><%- icon('lock') %>Change password</a>
        <a class="dropdown__item" role="menuitem" href="/hospital"><%- icon('hospital') %>Hospital information</a>
        <div class="dropdown__sep"></div>
        <button type="button" class="dropdown__item dropdown__item--danger" role="menuitem" data-logout><%- icon('log-out') %>Logout</button>
      </div>
    </div>
  </div>
</header>
